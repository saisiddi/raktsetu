# copy this file to .env.local, fill in the values from your Supabase project (Project Settings → API Keys), and restart `npm run dev`.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key (formerly the service_role key). Not used by the app
# yet. It bypasses Row Level Security, so never expose it to the browser and
# never give it a NEXT_PUBLIC_ prefix.
# Find it in API Keys -> Secret keys
# SUPABASE_SECRET_KEY=
